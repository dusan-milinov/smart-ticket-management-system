SPRING_DATASOURCE_URL=jdbc:mysql://DB_PRIVATE_IP:3306/ticket_management
SPRING_DATASOURCE_USERNAME=ticket_app
SPRING_DATASOURCE_PASSWORD=APPLICATION_PASSWORD
SECRET_KEY=RANDOM_SECRET_ON_BOTH_APP_INSTANCES_AT_LEAST_32_BYTES
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://ALB_DNS_NAME
SECURITY_JWT_COOKIE_SECURE=false
APP_SEED_ENABLED=false

# First application startup creates schema; second should use validate after that succeeds.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
